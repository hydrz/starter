# Required for local development. This URL contains local Docker credentials only.
DATABASE_URL=postgres://starter:starter@127.0.0.1:5432/starter?sslmode=disable

# HTTP server (both are optional; HTTP_ADDRESS takes precedence over PORT).
# HTTP_ADDRESS=:8080
# PORT=8080
# AUTO_MIGRATE=true

# Optional authentication. Leave every AUTH_JWT_* value unset to disable auth setup.
# Access tokens use Ed25519 (EdDSA), never an HMAC/shared secret. All values below
# are required together. Values are base64url without padding; never commit real keys.
# AUTH_JWT_ACTIVE_KID=2026-09
# AUTH_JWT_SIGNING_PRIVATE_KEY=replace-with-base64url-encoded-ed25519-private-key
# AUTH_JWT_VERIFICATION_KEYSET={"2026-09":"replace-with-base64url-encoded-ed25519-public-key","2026-06":"retired-public-key-still-accepted-during-rotation"}
# AUTH_JWT_ISSUER=starter
# AUTH_JWT_ACCESS_TTL=15m
# AUTH_REFRESH_TOKEN_TTL=720h
# AUTH_SECRET_PEPPER=replace-with-a-long-random-string-unrelated-to-the-signing-key
# Future issuers must sign with the active private key and protected-header kid.
# Future verifiers must reject missing/unknown kid and choose the public key from the keyset.
# Rotate by first adding a new verification key, then deploying it as ACTIVE_KID with its private key,
# and retain retired public keys until every access token signed by them has expired.
# AUTH_SECRET_PEPPER keys the HMAC digest of stored refresh/reset/API-key secrets. It is
# independent of the JWT signing key so rotating one never invalidates the other.

# Optional OAuth providers. Each provider requires all three values.
# OAUTH_GOOGLE_CLIENT_ID=example-google-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# OAUTH_GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/api/auth/google/callback
# OAUTH_GITHUB_CLIENT_ID=example-github-client-id
# OAUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# OAUTH_GITHUB_REDIRECT_URL=http://127.0.0.1:8080/api/auth/github/callback

# Optional WebAuthn relying party. All three values are required together.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Starter Local
# WEBAUTHN_RP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP delivery channel. All five values are required together.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_USERNAME=starter-local
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM_ADDRESS=Starter Local <noreply@example.test>

# Optional Stripe integration. All three values are required together.
# STRIPE_SECRET_KEY=sk_test_replace_with_your_key
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_secret
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_key

# Optional outbox worker. Disabled unless WORKER_ENABLED is true.
# WORKER_ENABLED=false
# WORKER_POLL_INTERVAL=1s
# WORKER_BATCH_SIZE=50

# Optional Casbin authorization. Both paths are required together.
# AUTHORIZATION_MODEL_PATH=config/casbin/model.conf
# AUTHORIZATION_POLICY_PATH=config/casbin/policy.csv
